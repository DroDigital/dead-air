    "@gltf-transform/functions": "4.5.1",
    "@types/node": "22.19.0",
    "@types/three": "0.187.0",
    "lil-gui": "0.21.0",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "4.0.8"
